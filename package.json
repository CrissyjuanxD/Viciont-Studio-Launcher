{
  "name": "viciont-studio-launcher",
  "productName": "Viciont Studios Launcher",
  "version": "1.2.1",
  "description": "Launcher de Minecraft de Viciont Studios: instancias públicas y privadas, cuentas premium y no premium, skins y descargas rápidas.",
  "author": {
    "name": "CrissyjuanxD",
    "url": "https://github.com/CrissyjuanxD"
  },
  "license": "SEE LICENSE IN LICENSE",
  "homepage": "https://github.com/CrissyjuanxD/Viciont-Studio-Launcher",
  "repository": {
    "type": "git",
    "url": "https://github.com/CrissyjuanxD/Viciont-Studio-Launcher.git"
  },
  "main": "src/main/main.js",
  "desktopName": "viciont-studios-launcher.desktop",
  "private": true,
  "scripts": {
    "start": "electron .",
    "vendor": "node scripts/vendor.js",
    "dist": "electron-builder --win --x64",
    "dist:mac": "electron-builder --mac --universal",
    "dist:linux": "electron-builder --linux --x64",
    "release": "electron-builder --win --x64 --publish always"
  },
  "dependencies": {
    "electron-updater": "^6.8.9",
    "yauzl": "^3.4.0"
  },
  "devDependencies": {
    "@fontsource/bebas-neue": "^5.3.0",
    "@fontsource/chakra-petch": "^5.3.0",
    "@fontsource/share-tech-mono": "^5.3.0",
    "electron": "^44.4.5",
    "electron-builder": "^26.15.3",
    "skinview3d": "^3.4.2"
  },
  "build": {
    "appId": "com.viciontstudios.launcher",
    "productName": "Viciont Studios Launcher",
    "copyright": "© 2026 CrissyjuanxD · Viciont Studios",
    "directories": {
      "output": "dist",
      "buildResources": "build"
    },
    "files": [
      "src/**/*",
      "package.json",
      "!src/**/*.map",
      "!**/*.md"
    ],
    "asar": true,
    "electronFuses": {
      "runAsNode": false,
      "enableCookieEncryption": true,
      "enableNodeOptionsEnvironmentVariable": false,
      "enableNodeCliInspectArguments": false,
      "enableEmbeddedAsarIntegrityValidation": true,
      "onlyLoadAppFromAsar": true,
      "grantFileProtocolExtraPrivileges": false
    },
    "electronLanguages": [
      "es",
      "es-419",
      "es_419",
      "en-US"
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "build/icon.ico",
      "artifactName": "Viciont-Studios-Launcher-Setup-${version}.${ext}",
      "executableName": "Viciont Studio Launcher"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowElevation": true,
      "allowToChangeInstallationDirectory": false,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Viciont Studios Launcher",
      "uninstallDisplayName": "Viciont Studios Launcher ${version}",
      "installerIcon": "build/icon.ico",
      "uninstallerIcon": "build/icon.ico",
      "installerHeaderIcon": "build/icon.ico",
      "installerHeader": "build/installerHeader.bmp",
      "installerSidebar": "build/installerSidebar.bmp",
      "uninstallerSidebar": "build/uninstallerSidebar.bmp",
      "include": "build/installer.nsh",
      "language": "3082",
      "installerLanguages": [
        "es_ES"
      ],
      "multiLanguageInstaller": true,
      "runAfterFinish": true,
      "deleteAppDataOnUninstall": false,
      "displayLanguageSelector": false
    },
    "mac": {
      "target": [
        {
          "target": "dmg",
          "arch": [
            "universal"
          ]
        },
        {
          "target": "zip",
          "arch": [
            "universal"
          ]
        }
      ],
      "icon": "build/icon.png",
      "category": "public.app-category.games",
      "artifactName": "Viciont-Studios-Launcher-${version}-mac.${ext}",
      "identity": "-",
      "hardenedRuntime": false,
      "gatekeeperAssess": false,
      "darkModeSupport": true,
      "extendInfo": {
        "NSMicrophoneUsageDescription": "Minecraft necesita el micrófono para los mods de chat de voz.",
        "NSCameraUsageDescription": "Un mod de Minecraft quiere usar la cámara.",
        "NSLocalNetworkUsageDescription": "Minecraft usa la red local para encontrar y unirse a partidas LAN."
      }
    },
    "dmg": {
      "title": "Viciont Studios Launcher",
      "writeUpdateInfo": false
    },
    "linux": {
      "target": [
        {
          "target": "AppImage",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "deb",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "rpm",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "build/icon.png",
      "category": "Game",
      "executableName": "viciont-studios-launcher",
      "syncDesktopName": true,
      "artifactName": "Viciont-Studios-Launcher-${version}-linux-${arch}.${ext}",
      "maintainer": "CrissyjuanxD <113305236+CrissyjuanxD@users.noreply.github.com>",
      "vendor": "Viciont Studios",
      "synopsis": "Launcher de Minecraft de Viciont Studios",
      "description": "Launcher de Minecraft de Viciont Studios: instancias públicas y privadas, cuentas premium y no premium, skins y descargas rápidas."
    },
    "deb": {
      "packageName": "viciont-studios-launcher",
      "recommends": [
        "libappindicator3-1",
        "x11-xserver-utils"
      ]
    },
    "rpm": {
      "packageName": "viciont-studios-launcher"
    },
    "toolsets": {
      "appimage": "1.0.3"
    },
    "publish": [
      {
        "provider": "github",
        "owner": "CrissyjuanxD",
        "repo": "Viciont-Studio-Launcher",
        "releaseType": "release"
      }
    ]
  }
}
