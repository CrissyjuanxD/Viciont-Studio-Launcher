{
  "name": "viciont-studio-launcher",
  "productName": "Viciont Studios Launcher",
  "version": "1.1.9",
  "description": "Launcher de Minecraft de Viciont Studios: instancias públicas y privadas, cuentas premium y no premium, skins y descargas rápidas.",
  "author": {
    "name": "CrissyjuanxD",
    "url": "https://github.com/CrissyjuanxD"
  },
  "license": "SEE LICENSE IN LICENSE",
  "homepage": "https://github.com/CrissyjuanxD/Viciont-Studio-Launcher",
  "repository": {
    "type": "git",
    "url": "https://github.com/CrissyjuanxD/Viciont-Studio-Launcher.git"
  },
  "main": "src/main/main.js",
  "private": true,
  "scripts": {
    "start": "electron .",
    "vendor": "node scripts/vendor.js",
    "dist": "electron-builder --win --x64",
    "release": "electron-builder --win --x64 --publish always"
  },
  "dependencies": {
    "electron-updater": "^6.8.9",
    "yauzl": "^3.4.0"
  },
  "devDependencies": {
    "@fontsource/bebas-neue": "^5.3.0",
    "@fontsource/chakra-petch": "^5.3.0",
    "@fontsource/share-tech-mono": "^5.3.0",
    "electron": "^44.4.5",
    "electron-builder": "^26.15.3",
    "skinview3d": "^3.4.2"
  },
  "build": {
    "appId": "com.viciontstudios.launcher",
    "productName": "Viciont Studios Launcher",
    "copyright": "© 2026 CrissyjuanxD · Viciont Studios",
    "directories": {
      "output": "dist",
      "buildResources": "build"
    },
    "files": [
      "src/**/*",
      "package.json",
      "!src/**/*.map",
      "!**/*.md"
    ],
    "asar": true,
    "electronFuses": {
      "runAsNode": false,
      "enableCookieEncryption": true,
      "enableNodeOptionsEnvironmentVariable": false,
      "enableNodeCliInspectArguments": false,
      "enableEmbeddedAsarIntegrityValidation": true,
      "onlyLoadAppFromAsar": true,
      "grantFileProtocolExtraPrivileges": false
    },
    "electronLanguages": [
      "es",
      "es-419",
      "en-US"
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "build/icon.ico",
      "artifactName": "Viciont-Studios-Launcher-Setup-${version}.${ext}",
      "executableName": "Viciont Studio Launcher"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowElevation": true,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Viciont Studios Launcher",
      "uninstallDisplayName": "Viciont Studios Launcher ${version}",
      "installerIcon": "build/icon.ico",
      "uninstallerIcon": "build/icon.ico",
      "installerHeaderIcon": "build/icon.ico",
      "installerSidebar": "build/installerSidebar.bmp",
      "uninstallerSidebar": "build/uninstallerSidebar.bmp",
      "include": "build/installer.nsh",
      "language": "3082",
      "installerLanguages": [
        "es_ES"
      ],
      "multiLanguageInstaller": true,
      "runAfterFinish": true,
      "deleteAppDataOnUninstall": false,
      "displayLanguageSelector": false
    },
    "publish": [
      {
        "provider": "github",
        "owner": "CrissyjuanxD",
        "repo": "Viciont-Studio-Launcher",
        "releaseType": "release"
      }
    ]
  }
}
